# Sovereign Platform — local dev environment variables.
# Copy to .env, edit as needed. Never commit a populated .env.

# ── Cloud / object store ──────────────────────────────────────────────
AWS_REGION=us-east-1

# DynamoDB. AWS_ACCESS_KEY_ID/SECRET feed boto3's standard credential
# chain. 'local' satisfies DynamoDB Local (which accepts any non-empty
# creds); production replaces these with a real IAM role and removes
# the explicit endpoint URL.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://dynamodb-local:8000

# Object store (MinIO in dev). Note that S3 creds are separate from
# the AWS_* creds above because MinIO uses its own user/password.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CONFIG_BUCKET=sovereign-configs

# ── ClickHouse (audit service only) ───────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=sovereign

# ── Service URLs (docker-compose service names) ───────────────────────
CONTROL_PLANE_URL=http://control-plane:8090
AUDIT_SERVICE_URL=http://audit-service:8086
METERING_SERVICE_URL=http://metering-service:8087

# OPA policy engine (Phase 2). The broker calls this on every
# provision/update to evaluate sovereign.decision.
OPA_URL=http://opa:8181
OPA_DECISION_PATH=v1/data/sovereign/decision

# ── Environment marker ───────────────────────────────────────────────
# Drives every fail-closed guardrail below. SECURE BY DEFAULT: only the
# development allowlist {dev, development, local, test, testing, ci}
# relaxes the guardrails and tolerates the baked-in dev credentials.
# ANY other value — "staging", "demo", "gov-prod", or a typo — is treated
# as a managed environment: strict secrets, OIDC, managed-secrets and
# workload-identity all default ON and startup REFUSES to run on a dev
# sentinel. Leave unset for local dev (defaults to "dev").
ENV=dev

# ── Auth — OSB basic creds + shared bearer for inter-service calls ────
BROKER_USERNAME=broker
BROKER_PASSWORD=broker
DEV_BEARER_TOKEN=dev-token
SHARED_BEARER_AUTH_ENABLED=true
# OSB Basic-auth callers bypass RBAC when true (dev/back-compat convenience).
# Defaults false in any non-dev ENV, and a managed environment REFUSES to
# start if this is forced true — the bypass has no safe use in a shared deploy.
BROKER_TRUST_BASIC_AUTH=true

# Production workload identity is expected to be asserted by a trusted
# mTLS front door or service mesh. Local dev keeps this disabled.
# When enabled, each service asserts WORKLOAD_IDENTITY on its outbound
# service-to-service calls and the inbound side verifies it against
# ALLOWED_WORKLOAD_IDENTITIES. WORKLOAD_IDENTITY defaults to a SPIFFE-style
# id derived from SERVICE_NAME (spiffe://sovereign/<service>); a real mesh
# overrides it with the injected SVID. With SHARED_BEARER_AUTH_ENABLED=false
# this is the ONLY accepted service-to-service auth (no shared token).
WORKLOAD_IDENTITY_ENABLED=false
WORKLOAD_IDENTITY=
ALLOWED_WORKLOAD_IDENTITIES=
# Mesh mTLS (hardened posture). When true, the inbound side trusts ONLY the
# peer identity the mesh verified via mTLS and forwarded as the XFCC header
# (X-Forwarded-Client-Cert); plain X-SPIFFE-ID / X-Sovereign-Workload-Identity
# headers are ignored because they are forgeable on a direct path. The SPIFFE
# id is read from the leaf cert's URI SAN and checked against
# ALLOWED_WORKLOAD_IDENTITIES. Defaults on for any non-dev ENV, so a deploy
# fails closed unless a mesh is actually terminating mTLS and injecting XFCC.
MTLS_REQUIRED=false

# Phase-3 tenant-aware JWT auth. Production uses JWKS verification
# against the agency IdP (task 3.5); this HS256 secret exists for
# local dev + tests so contributors can mint dev tokens without an IdP.
DEV_JWT_SECRET=dev-jwt-secret-replace-me-with-a-real-one

# OIDC IdP integration (Phase 3 task 3.5). When OIDC_ISSUER_URL is set
# the broker verifies RS256/ES256 tokens against the issuer's JWKS
# instead of HS256-dev tokens. See docs/idp-integration.md for the
# Login.gov, Azure AD GCC, ICAM (PIV/CAC via SAML→OIDC gateway) recipes.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
REQUIRE_OIDC=false

# ── Secrets provider ─────────────────────────────────────────────────
# Local dev reads SOVEREIGN_SECRET_<NAME> env vars. Production uses
# aws-secrets-manager or aws-ssm and should keep REQUIRE_MANAGED_SECRETS=true.
#
# When SECRETS_PROVIDER is NOT "env", startup resolves these sensitive
# settings from the backend (SECRETS_PREFIX is prepended to each name) and
# overrides the env/dev value, so every service runs on the real secret:
#   service-bearer-token      -> DEV_BEARER_TOKEN
#   broker-password           -> BROKER_PASSWORD
#   s3-access-key             -> S3_ACCESS_KEY
#   s3-secret-key             -> S3_SECRET_KEY
#   jwt-signing-secret        -> DEV_JWT_SECRET
#   audit-signing-private-key -> AUDIT_SIGNING_PRIVATE_KEY_PEM
#   siem-webhook-token        -> SIEM_WEBHOOK_TOKEN
# A secret missing from the backend is left at its current value; the
# sentinel gate then fails closed if a required one was never supplied.
SECRETS_PROVIDER=env
SECRETS_PREFIX=
REQUIRE_MANAGED_SECRETS=false
