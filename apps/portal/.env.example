# Sovereign Portal — build-time environment.
# Vite inlines VITE_* values; non-VITE vars are ignored by the build.

# Where the broker lives. Leave blank to use the dev proxy in vite.config.ts.
VITE_BROKER_URL=

# Audit-service URL. Same proxy treatment in dev.
VITE_AUDIT_URL=

# Default bearer token presented to the broker / audit service from the
# UI's "use dev token" login button. Production deployments don't set
# this — users log in via OIDC.
VITE_DEV_BEARER_TOKEN=dev-token
